# 铭远ERP 后端环境变量示例
# 复制为 .env 后填写实际值

# 应用
APP_NAME=铭远ERP系统API
DEBUG=true

# 数据库 (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx123456789.
MYSQL_DATABASE=mingyuan_erp
MYSQL_POOL_SIZE=32

# JWT（后续登录用）上线前务必改成随机、足够长的字符串
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 可选：部署路径（默认自动检测含 templates/ 的项目根目录）
# ERP_PROJECT_ROOT=C:/mingyuan-erp
# QC_MAPPING_XLSX=C:/mingyuan-erp/backend/resources/qc_placeholder_mapping.xlsx
# CORS_ALLOW_ORIGINS=http://xxx.xx.xxx.xxx,http://your-domain.com

# 业务持久数据根目录（合同原件等；发版勿覆盖）。现网建议：
# ERP_DATA_DIR=C:\mingyuan-erp\data

# PDF 转换（质保书 docx → pdf，仅当 API 收到 output_format=pdf 时在服务器执行）
# 桌面客户端质检 PDF 已改为本机 Word/WPS 转换，服务器始终只生成 Word，下列项可忽略
# word：Windows 服务器 MS Word COM | libreoffice：LibreOffice
PDF_CONVERTER=word
PDF_WORD_LOCK_TIMEOUT=120
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe

# 质保书 PDF 输出模式（桌面客户端 PDF 不经过此路径，可保持 word 供服务器单页压缩 Word）
# word / libreoffice = 服务器 Word 渲染后转 PDF | direct = AcroForm 直填
QC_PDF_RENDER_MODE=word
# 填模板后压缩为单页（服务器 Word 输出；客户端 PDF 前也会用到已压缩的 docx）
QC_CERT_SINGLE_PAGE=true
# direct 模式填表引擎（当前仅 acroform）
QC_PDF_FILL_ENGINE=acroform
